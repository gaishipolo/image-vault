# Flask 配置
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
FLASK_ENV=development
FLASK_DEBUG=1

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@localhost:3306/image_vault

# JWT 配置
JWT_SECRET_KEY=change-this-to-another-random-secret-key-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES=3600

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 速率限制
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_LOGIN=5 per minute

# 文件上传限制 (50MB)
MAX_CONTENT_LENGTH=52428800
